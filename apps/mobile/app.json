{
  "expo": {
    "name": "Registro de Campo",
    "slug": "registro-de-campo",
    "scheme": "registrocampo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.registrodecampo.app"
    },
    "android": {
      "package": "com.registrodecampo.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Registro de Campo use a câmera para fotografar os registros."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Registro de Campo use sua localização durante a coleta."
        }
      ]
    ]
  }
}
